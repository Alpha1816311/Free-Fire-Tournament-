# GEMINI_API_KEY: Optional if AI features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT=3000

# ADMIN_SESSION_SECRET: Secret key used to sign HMAC administrator session tokens
ADMIN_SESSION_SECRET="your_production_secure_random_session_secret_change_me"
